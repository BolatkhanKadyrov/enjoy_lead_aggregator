BOT_TOKEN=
ADMIN_IDS=
# First deployment: contents of the private enjoy-catalog.json.
INITIAL_CATALOG_JSON=
# Automatically supplied when the Railway service has a public domain.
PUBLIC_URL=
# Used locally. On Railway attach a volume at /data.
DATA_DIR=data
PORT=8080
# Optional intake limits, shared by XLSX imports and explicit /resume requests.
UPLOAD_COOLDOWN_SECONDS=30
UPLOADS_PER_USER_PER_10_MINUTES=5
UPLOADS_PER_MINUTE_TOTAL=10
